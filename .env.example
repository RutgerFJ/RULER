# =============================================================================
# RULER Configuration
# =============================================================================
# Copy this file to .env and modify values as needed for your environment

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=mlva.settings

# =============================================================================
# Docker Port Mapping
# =============================================================================
# External ports are exposed to your host machine
# Internal ports are used within the Docker container network

# Redis Service
REDIS_EXTERNAL_PORT=6380
REDIS_INTERNAL_PORT=6379

# Django Web Service
WEB_EXTERNAL_PORT=1337
WEB_INTERNAL_PORT=1338

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=${REDIS_INTERNAL_PORT}

# Separate Redis databases for different queue types
REDIS_DB_DEFAULT=0
REDIS_DB_MLVA=1

# =============================================================================
# RQ Worker Configuration
# =============================================================================
# Comma-separated list of queues for RQ worker to monitor
RQ_QUEUES=mlva,default

# Job timeout settings (in seconds)
JOB_TIMEOUT=300
BLAST_TIMEOUT=600

# =============================================================================
# Python Configuration
# =============================================================================
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# =============================================================================
# Application Settings
# =============================================================================
# Output directory for MLVA analysis results
OUTPUT_DIR=/tmp/mlva_output

# Enable verbose logging during task execution
VERBOSE_OUTPUT=False

# =============================================================================
# Development Settings
# =============================================================================
# Set to False in production
DEBUG=True
